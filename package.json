{
  "name": "reader-helper-electron",
  "version": "0.1.0",
  "description": "Electron reader helper for txt upload, chapter parsing, SQLite storage and HTML service",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.readerhelper.app",
    "productName": "Reader Helper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*.{md,MD,markdown}",
      "!**/*.log"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^26.2.0",
    "electron-builder": "^24.6.0"
  },
  "author": "",
  "license": "MIT"
}
